# PharmGuard Environment Configuration

# OpenAI API Key (for LangChain OpenAI components)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (for high-speed cloud inference)
GROQ_API_KEY=your_groq_api_key_here

# ChromaDB Settings
CHROMA_PERSIST_DIR=chroma_db

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
